                      (and (boundp 'doom-leader-alt-map) doom-leader-alt-map)))
  (when leader
    (let ((toggle-map (lookup-key leader (kbd "t"))))
      (when (keymapp toggle-map)
        (define-key leader (kbd "T") (copy-keymap toggle-map))
        (define-key leader (kbd "t") (make-sparse-keymap))))))

