;; ── Custom protocol: denote-link (yd in Tridactyl/qutebrowser) ─────────────

(defun my/org-protocol-denote-link (data)
  "Create a Denote reference note from a browser URL and TITLE.
DATA is the org-protocol plist with :url and :title.
This is a pure Denote capture — no journal entry is created."
  (let* ((url        (or (plist-get data :url) ""))
         (title      (or (plist-get data :title) url))
         (keywords   '("reference" "web"))
         (dir        (my/denote--library-subdirectory keywords))
         (id         (format-time-string "%Y%m%dT%H%M%S"))
         (slug       (denote-sluggify title))
         (kw-combined (denote-keywords-combine
                       (denote-sluggify-keywords-and-apply-rules keywords)))
         (fname      (format "%s/%s--%s__%s.org" dir id slug kw-combined)))
    (make-directory dir t)
    (with-temp-file fname
      (set-buffer-file-coding-system 'utf-8)
      (insert (format "#+title:      %s\n" title))
      (insert (format "#+date:       %s\n" (format-time-string "[%Y-%m-%d %a]")))
      (insert "#+filetags:   :reference:web:\n")
      (insert (format "#+identifier: %s\n\n" id))
      (insert "* Source\n\n")
      (insert (format "[[%s][%s]]\n\n" url title))
      (insert "* Key Points\n\n")
      (insert "* Overview\n\n"))
    (message "Denote: saved %s as reference note" title)))

(add-to-list 'org-protocol-protocol-alist
  '("denote-link" :protocol "denote-link"
    :function my/org-protocol-denote-link
    :kill-client t))
