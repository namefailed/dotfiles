(defun my/denote-verify-links ()
  "Check all denote links in current file for valid IDs.
Reports broken links in a *Denote Link Check* buffer."
  (interactive)
  (let ((broken '()))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward "\\[\\[denote:\\([0-9T]+\\)\\]" nil t)
        (let* ((id (match-string 1))
               (files (denote-directory-files id)))
          (when (null files)
            (push (format "Line %d: Broken link to %s" (line-number-at-pos) id) broken)))))
    (if broken
        (with-current-buffer (get-buffer-create "*Denote Link Check*")
          (erase-buffer)
          (insert "Broken Denote Links:\n\n")
          (dolist (b (nreverse broken)) (insert b "\n"))
          (pop-to-buffer (current-buffer)))
      (message "All Denote links valid."))))

