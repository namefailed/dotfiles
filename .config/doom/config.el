(defvar my/eod-pending nil
  "Non-nil when today's EOD section needs attention.")

(defun my/eod-harass ()
  "Harass the user to close their EOD until they do."
  (when (>= (string-to-number (format-time-string "%H")) 18)
    (condition-case nil
        (save-window-excursion
          (find-file (expand-file-name my/org-journal-file))
          (org-datetree-find-date-create (calendar-current-date))
          (if (my/org-journal--goto-heading-in-day 4 "EOD")
              (let* ((section-start (progn (forward-line 1) (point)))
                     (section-end (my/org-journal--next-heading-point))
                     (contents (buffer-substring-no-properties section-start section-end)))
                (if (string-blank-p contents)
                    (progn
                      (setq my/eod-pending t)
                      (select-frame-set-input-focus (selected-frame))
                      (when (executable-find "powershell")
                        (call-process "powershell" nil nil nil
                          "-Command"
                          "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.MessageBox]::Show('EOD is empty — wrap up your day!', '⚠ Journal Reminder', 'OK', 'Warning')"))
                      (ding t))
                  (setq my/eod-pending nil)))
            (setq my/eod-pending nil))
          (unless (get-buffer-window (current-buffer))
            (kill-buffer (current-buffer))))
      (error nil))))

(run-with-idle-timer 120 t #'my/eod-harass)

;; Persistent mode-line indicator — ⚠EOD shows red while EOD is empty
(push '(:eval (when my/eod-pending
                (propertize " ⚠EOD" 'face '(:background "#f38ba8" :foreground "#1e1e2e" :weight bold))))
      global-mode-string)

(defun my/org-journal-process-eod ()
  "Scan today's Tasks section and populate EOD Done/Next.
Done (closed) items are collected under ***** Done.
Still-open items are collected under ***** Next.
Original tasks in Tasks are left intact."
  (interactive)
  (save-window-excursion
    (find-file my/org-journal-file)
    (org-datetree-find-date-create (calendar-current-date))
    (my/org-journal-ensure-day-structure)
    (let (done-items open-items)
      (when (my/org-journal--goto-heading-in-day 4 "Tasks")
        (org-back-to-heading t)
        (let ((section-end (save-excursion (org-end-of-subtree t t) (point))))
          (forward-line 1)
          (while (< (point) section-end)
            (cond
             ((looking-at "^\\*\\*\\*\\*\\* DONE ")
              (push (buffer-substring-no-properties (match-end 0) (line-end-position)) done-items))
             ((looking-at "^\\*\\*\\*\\*\\* TODO ")
              (push (buffer-substring-no-properties (match-end 0) (line-end-position)) open-items))
             ((looking-at "^\\*\\*\\*\\*\\* NEXT ")
              (push (concat "NEXT " (buffer-substring-no-properties (match-end 0) (line-end-position))) open-items))
             ((looking-at "^\\*\\*\\*\\*\\* WAIT ")
              (push (concat "WAIT " (buffer-substring-no-properties (match-end 0) (line-end-position))) open-items)))
            (forward-line 1))))
      (when (or done-items open-items)
        (my/org-journal--goto-heading-in-day 4 "EOD")
        (org-back-to-heading t)
        (when done-items
          (my/org-journal--goto-heading-in-day 5 "Done"))
        (when open-items
          (my/org-journal--goto-heading-in-day 5 "Next"))
        (setq my/eod-pending nil)
        (save-buffer)
        (message "EOD processed: %d done, %d open" (length done-items) (length open-items))))))

(defun my/org-journal-fold-old-years ()
  "Fold all year-level headings before the current year when opening journal.org.
This keeps old journal entries collapsed while keeping current year expanded."
  (when (and buffer-file-name
             (file-equal-p (expand-file-name buffer-file-name)
                           (expand-file-name my/org-journal-file)))
    (let ((current-year (nth 5 (decode-time))))
      (save-excursion
        (goto-char (point-min))
        (while (re-search-forward "^\\* \\([0-9]\\{4\\}\\)" nil t)
          (let ((year (string-to-number (match-string 1))))
            (when (< year current-year)
              (ignore-errors (outline-hide-subtree)))))))))

(add-hook 'org-mode-hook #'my/org-journal-fold-old-years)
