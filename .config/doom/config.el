;; [[file:config.org::*Auto-Tangle Literate Configs][Auto-Tangle Literate Configs:1]]
(defun my/auto-tangle-config-org ()
  "Tangle the current buffer if it's a .org file in ~/.config/.
Shows a message when tangling completes."
  (when (and buffer-file-name
             (string-match-p "/\\.config/.*\\.org\\'" buffer-file-name))
    (let ((start-time (current-time)))
      (org-babel-tangle)
      (message "Tangled %s (%.1fs)"
               (file-name-nondirectory buffer-file-name)
               (float-time (time-subtract (current-time) start-time))))))

(add-hook 'after-save-hook #'my/auto-tangle-config-org)
