(defalias
  kwl-ret (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
             "C:/Users/Namef/.config/scripts/kanata/emacs-home-frame.ps1")

  kwl-j (switch
    ((input real lsft))
      (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
        "C:/Users/Namef/.config/scripts/kanata/emacs-daily-review.ps1") break
    ()
      (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
        "C:/Users/Namef/.config/scripts/kanata/emacs-notes.ps1") break
  )

  kwl-t (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
           "C:/Users/Namef/.config/scripts/kanata/emacs-quick-task.ps1")

  kwl-f (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
             "C:/Users/Namef/.config/scripts/kanata/focus-or-launch.ps1"
             -ProcessName firefox
             -LaunchPath "C:/Program Files/Mozilla Firefox/firefox.exe")

  kwl-o (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
             "C:/Users/Namef/.config/scripts/kanata/focus-or-launch.ps1"
             -ProcessName olk
              -LaunchPath "(replace-regexp-in-string "\\\\" "/" (expand-file-name "~/AppData/Local/Microsoft/WindowsApps/olk.exe"))")

  kwl-p (cmd pwsh.exe -WindowStyle Hidden -NonInteractive -NoProfile -File
             "C:/Users/Namef/.config/scripts/kanata/focus-or-launch.ps1"
             -ProcessName PhoneExperienceHost
             -LaunchPath explorer.exe
             -Arguments "shell:AppsFolder\Microsoft.YourPhone_8wekyb3d8bbwe!App")

  kwl-spc (switch
    ()
      spc break
  )

  kwl-s s
)

(deflayer default
  caps        ;; esc  → CapsLock  (physical positions swapped)
  @cap        ;; caps → Esc on tap / Vim layer on hold
  @a-hrm @s-hrm @d-hrm @f-hrm @semi-hrm
  @h-wm @j-hrm @k-hrm @l-hrm
  u y p w @b-win @g-wm
  4 0 c x @grv-mouse
  1 2
  @lalt-kwm lsft
  t q m i r
  [ ]
  = -
  , .
  3 5 6 7 8
  @ret-ext-toggle
  lctl left down up right
  z spc
  @lmet-app o n /
  @tab-numr e @profile-toggle
  @apos-numl  ;; ' → tap: apostrophe / hold: left-hand numpad layer
)

(deflayer nomods
  esc @cap a s d f ; h j k l u y p w b g 4 0 c x grv 1 2
  lalt lsft
  t q m i r
  [ ]
  = -
  , .
  3 5 6 7 8
  @ret-ext-toggle
  lctl left down up right
  z spc
  lmet o n /
  tab e @profile-toggle
  '   ;; ' → literal apostrophe (no layer trigger during nomods window)
)

(deflayer vim
  _        ;; esc
  _        ;; caps
  C-a      ;; a → Select All
  _        ;; s
  pgdn     ;; d → Page Down
  _        ;; f
  _        ;; ;
  left     ;; h → ←
  down     ;; j → ↓
  up       ;; k → ↑
  right    ;; l → →
  pgup     ;; u → Page Up
  C-c      ;; y → Copy
  C-v      ;; p → Paste
  @wkey    ;; w → word forward (C-→)
  @bkey    ;; b → word backward (C-←)
  @gnav    ;; g → end of doc / start of doc (tap-dance)
  End      ;; 4 → End of line
  Home     ;; 0 → Start of line
  C-x      ;; c → Cut
  Delete   ;; x → Delete
  _        ;; grv
  _        ;; 1
  _        ;; 2
  _        ;; lalt
  _        ;; lsft
  _        ;; t
  _        ;; q
  _        ;; m
  _        ;; i
  C-S-z    ;; r → Redo
  _        ;; [
  _        ;; ]
  _        ;; =
  _        ;; -
  _        ;; ,
  _        ;; .
  _        ;; 3
  _        ;; 5
  _        ;; 6
  _        ;; 7
  _        ;; 8
  @ret-ext-toggle        ;; ret
  _        ;; lctl
  _        ;; left
  _        ;; down
  _        ;; up
  _        ;; right
  C-z      ;; z → Undo
  _        ;; spc
  _        ;; lmet
  @vim-o   ;; o → open line below
  f3       ;; n → Find next  (Shift+n = Find prev via lsft passthrough)
  C-f      ;; / → Open find
  _        ;; tab
  _        ;; e
  @profile-toggle
  '        ;; ' → literal apostrophe (numpad layer suppressed while Caps held)
)

(deflayer lalt-komorebi
  _         ;; esc
  _         ;; caps
  @kwm-a    ;; a   → unstack-all / Shift: stack-all
  _         ;; s
  _         ;; d
  @kwm-f    ;; f   → toggle-monocle
  @kwm-semi ;; ;   → unstack
  @kwm-h    ;; h   → focus/move/cycle-workspace/send (modifier matrix)
  @kwm-j    ;; j   → focus/move/cycle-monitor/send (modifier matrix)
  @kwm-k    ;; k   → focus/move/cycle-monitor/send (modifier matrix)
  @kwm-l    ;; l   → focus/move/cycle-workspace/send (modifier matrix)
  @kwm-u    ;; u   → pass-through / Shift: send-to-last-workspace
  @kwm-y    ;; y   → flip-layout vertical
  @kwm-p    ;; p   → toggle-pause
  _         ;; w
  @kwm-b    ;; b   → toggle bar
  @kwm-g    ;; g   → cycle-layout / Shift: change-layout bsp
  @kwm-4    ;; 4   → focus/move workspace 3 (ops)
  _         ;; 0
  _         ;; c
  @kwm-x    ;; x   → flip-layout horizontal
  _         ;; grv
  @kwm-1    ;; 1   → focus/move workspace 0
  @kwm-2    ;; 2   → focus/move workspace 1
  _         ;; lalt
  lsft      ;; lsft
  @kwm-t    ;; t   → toggle-float
  @kwm-q    ;; q   → close
  @kwm-m    ;; m   → minimize
  @kwm-i    ;; i   → toggle-shortcuts
  @kwm-r    ;; r   → pass-through / Shift: retile
  @kwm-lbrc ;; [   → cycle-stack prev / Shift: cycle-focus prev
  @kwm-rbrc ;; ]   → cycle-stack next / Shift: cycle-focus next
  @kwm-eq   ;; =   → resize horizontal+ / Shift: vertical+
  @kwm-mi   ;; -   → resize horizontal- / Shift: vertical-
  @kwm-cm   ;; ,   → cycle-workspace prev / Shift: cycle-move prev
  @kwm-dt   ;; .   → cycle-workspace next / Shift: cycle-move next
  @kwm-3    ;; 3   → focus/move workspace 2
  @kwm-5    ;; 5   → focus/move workspace 4 (cowork)
  @kwm-6    ;; 6   → focus/move workspace 5 (social)
  @kwm-7    ;; 7   → focus/move workspace 6 (focus)
  _         ;; 8   → unused (only 7 workspaces)
  @kwm-ret-ext-toggle  ;; ret → pass-through / Shift: promote
  lctl      ;; lctl
  @kwm-left ;; ←   → stack left
  @kwm-down ;; ↓   → stack down
  @kwm-up   ;; ↑   → stack up
  @kwm-right ;; →  → stack right
  @kwm-z    ;; z   → focus-last-workspace / Shift: move-to-last-workspace
  @kwm-spc  ;; spc → cycle monitor (send + follow)
  _         ;; lmet
  _         ;; o
  _         ;; n
  _         ;; /
  _         ;; tab
  _         ;; e
  @profile-toggle
  '         ;; ' → literal apostrophe (numpad layer suppressed in komorebi layer)
)

