    ((input real lctl))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" cycle-monitor previous) break
    ((input real lsft))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" move down) break
    ()
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" focus down) break
  )
  kwm-k (switch
    ((and (input real lctl) (input real lsft)))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" cycle-send-to-monitor next) break
    ((input real lctl))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" cycle-monitor next) break
    ((input real lsft))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" move up) break
    ()
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" focus up) break
  )
  kwm-l (switch
    ((and (input real lctl) (input real lsft)))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" cycle-move-to-workspace next) break
    ((input real lctl))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" cycle-workspace next) break
    ((input real lsft))
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" move right) break
    ()
      (cmd wscript.exe //B "C:/Users/Namef/.config/scripts/komorebi/komorebic-wrapper.vbs" focus right) break
