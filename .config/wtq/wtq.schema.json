          "$ref": "#/definitions/PreferMonitor"
        }
      ]
    },
    "MonitorIndex": {
      "title": "Monitor index",
      "type": [
        "integer",
        "null"
      ],
      "format": "int32",
      "default": 0,
      "maximum": 10.0,
      "minimum": 0.0
