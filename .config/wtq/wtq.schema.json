    "AnimationDurationMs": {
      "title": "Animation duration",
      "type": [
        "integer",
        "null"
      ],
      "format": "int32",
      "default": 250,
      "maximum": 1000.0,
      "minimum": 0.0
    },
    "AnimationTypeToggleOn": {
      "title": "Animation type (toggle ON)",
      "default": "EaseOutQuart",
