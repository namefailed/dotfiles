  "properties": {
    "AttachMode": {
      "title": "Attach mode",
      "default": "FindOrStart",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/AttachMode"
        }
      ]
    },
    "AlwaysOnTop": {
      "title": "Always on top",
      "type": [
        "boolean",
        "null"
      ],
      "default": false
    },
    "HideOnFocusLost": {
      "title": "Hide on focus lost",
      "default": "Always",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/HideOnFocusLost"
        }
      ]
    },
    "TaskbarIconVisibility": {
      "title": "Taskbar icon visibility",
      "default": "AlwaysHidden",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/TaskbarIconVisibility"
        }
      ]
    },
    "Opacity": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32",
      "default": 100
    },
    "Resize": {
      "title": "Resize app window",
      "default": "Always",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/Resizing"
        }
      ]
    },
    "HorizontalScreenCoverage": {
      "title": "Horizontal screen coverage",
      "type": [
        "null",
        "number"
      ],
      "format": "float",
      "default": 95.0
    },
    "HorizontalAlign": {
      "title": "Horizontal align",
      "default": "Center",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/HorizontalAlign"
        }
      ]
    },
    "VerticalScreenCoverage": {
      "title": "Vertical screen coverage",
      "type": [
        "null",
        "number"
      ],
      "format": "float",
      "default": 95.0
    },
    "VerticalOffset": {
      "title": "Vertical offset",
      "type": [
        "null",
        "number"
      ],
      "format": "float",
      "default": 0.0,
      "maximum": 1000.0,
      "minimum": 0.0
