    "OffScreenLocations": {
      "title": "Off-screen locations",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/OffScreenLocation"
      }
    },
    "PreferMonitor": {
      "title": "Prefer monitor",
      "default": "WithCursor",
