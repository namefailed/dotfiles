{
  "_comment": [
    "=============================================================",
    "DO NOT EDIT THIS FILE DIRECTLY.",
    "Generated from ~/.config/komorebi/komorebi.org",
    "Edit that file, tangle with `tangle C:\\Users\\Namef\\.config\\komorebi\\komorebi.org`,",
    "then restart Komorebi for changes to take effect.",
    "============================================================="
  ],

"app_specific_configuration_path": "$Env:USERPROFILE/.config/komorebi/applications.json",
"window_hiding_behaviour": "Cloak",
"cross_monitor_move_behaviour": "Insert",
"default_workspace_padding": 0,
"default_container_padding": 0,

"border": true,
"border_width": 5,
"border_offset": -1,

"ignore_rules": [
  {
    "kind": "Class",
    "id": "QuakeTerm",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Exe",
    "id": "wtq.exe",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Title",
    "id": "MSCTFIME UI",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Class",
    "id": "MSCTFIME UI",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Title",
    "id": "Default IME",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Exe",
    "id": "mscopilot.exe",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Exe",
    "id": "(?i)^mscopilot\\.exe$",
    "matching_strategy": "Regex"
  },
  [
    {
      "kind": "Exe",
      "id": "mscopilot.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "Chrome_WidgetWin_1",
      "matching_strategy": "Equals"
    }
  ],
  [
    {
      "kind": "Exe",
      "id": "ApplicationFrameHost.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Copilot",
      "matching_strategy": "Contains"
    }
  ],
  [
    {
      "kind": "Exe",
      "id": "qutebrowser.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "Qt\\d+QWindow.*Tool.*",
      "matching_strategy": "Regex"
    }
  ],
  {
    "kind": "Class",
    "id": "Qt\\d+QWindow.*Tool.*",
    "matching_strategy": "Regex"
  },
  {
    "kind": "Title",
    "id": "Phoneme Live Preview",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Title",
    "id": "Phoneme Recording Indicator",
    "matching_strategy": "Equals"
  }
],

"floating_applications": [
  {
    "kind": "Exe",
    "id": "(?i)^mscopilot\\.exe$",
    "matching_strategy": "Regex"
  },
  [
    {
      "kind": "Exe",
      "id": "mscopilot.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "Chrome_WidgetWin_1",
      "matching_strategy": "Equals"
    }
  ],
  [
    {
      "kind": "Exe",
      "id": "qutebrowser.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "Qt\\d+QWindowPopup.*",
      "matching_strategy": "Regex"
    }
  ]
],

"manage_rules": [

  {
    "kind": "Exe",
    "id": "qutebrowser.exe",
    "matching_strategy": "Equals"
  },
  {
    "kind": "Exe",
    "id": "claude.exe",
    "matching_strategy": "Equals"
  },
  [
    {
      "kind": "Exe",
      "id": "ApplicationFrameHost.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Claude",
      "matching_strategy": "Contains"
    }
  ]
],

"remove_titlebar_applications": [
  {
    "kind": "Exe",
    "id": "qutebrowser.exe",
    "matching_strategy": "Equals"
  }
],

"layered_applications": [
  {
    "kind": "Exe",
    "id": "Cursor.exe",
    "matching_strategy": "Equals"
  }
],

"theme": {
  "palette": "Catppuccin",
  "name": "Mocha",
  "single_border": "Pink",
  "stack_border": "Sky",
  "monocle_border": "Mauve",
  "floating_border": "Sapphire",
  "unfocused_border": "Surface1",
  "unfocused_locked_border": "Peach",
  "stackbar_background": "Surface0",
  "stackbar_focused_text": "Teal",
  "stackbar_unfocused_text": "Overlay0",
  "bar_accent": "Pink"
},

"animation": {
  "enabled": false,
  "duration": 100,
  "fps": 240,
  "style": {
    "movement": "Linear",
    "transparency": "Linear"
  }
},

"monitors": [
    {
      "workspaces": [
        {
          "name": "browse",
          "layout": "Grid",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "firefox.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "qutebrowser.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "write",
          "layout": "Grid",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "Obsidian.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Title",
              "id": "journal.org",
              "matching_strategy": "Contains"
            }
          ]
        },
        {
          "name": "code",
          "layout": "Grid",
          "initial_workspace_rules": [
            {
              "kind": "Title",
              "id": "main - code",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "ops",
          "layout": "Grid",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "explorer.exe",
              "matching_strategy": "Equals"
            },

            {
              "kind": "Exe",
              "id": "wezterm-gui.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Alacritty.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "cowork",
          "layout": "Scrolling",
          "layout_options": {
            "scrolling": {
              "columns": 2
            }
          },
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "claude.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Cursor.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "codex.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "antigravity.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "opencode.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "social",
          "layout": "Scrolling",
          "layout_options": {
            "scrolling": {
              "columns": 2
            }
          },
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "olk.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "PhoneExperienceHost.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Discord.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "slack.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Class",
              "id": "TeamsWebView",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Telegram.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Signal.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "focus",
          "layout": "Scrolling",
          "layout_options": {
            "scrolling": {
              "columns": 1
            }
          },
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "phoneme.exe",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    },
    {
      "workspaces": [
        { "name": "browse", "layout": "BSP" },
        { "name": "write", "layout": "BSP" },
        { "name": "code", "layout": "BSP" },
        { "name": "ops", "layout": "BSP" },
        { "name": "cowork", "layout": "BSP" },
        { "name": "social", "layout": "BSP" },
        { "name": "focus", "layout": "BSP" }
      ]
    }
  ]
}
